# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit it.
APP_NAME=Elisa Echo API
# development | test | production. Seeding and POST /api/sources only work in development/test.
ENVIRONMENT=development
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Tiger Data PostgreSQL. Paste the connection string from the Tiger Data console.
# postgres:// and postgresql:// are accepted and converted to the psycopg 3 async driver.
# Keep sslmode=require. Never put this in frontend/.env (VITE_ variables are public).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Optional connection pool tuning.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Phase 3 (not used yet). Backend only.
# GEMINI_API_KEY=
