# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit it.
APP_NAME=Elisa Echo API
# development | test | production. Seeding and POST /api/sources only work in development/test.
ENVIRONMENT=development
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Tiger Data PostgreSQL. Paste the connection string from the Tiger Data console.
# postgres:// and postgresql:// are accepted and converted to the psycopg 3 async driver.
# Keep sslmode=require. Never put this in frontend/.env (VITE_ variables are public).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Optional connection pool tuning.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Google Gemini (automatic knowledge discovery). Backend only, never in frontend/.env.
# Without a key the app runs, but conversations are not analyzed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Embeddings for search; must support 768 output dimensions (database column size).
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_MAX_ATTEMPTS=3            # total attempts incl. the first (bounded retries)

# Discovery pipeline tuning (in-process demo pipeline).
# DISCOVERY_DEBOUNCE_SECONDS=12     # wait after the last message before analyzing a thread
# DISCOVERY_MAX_CONCURRENT_ANALYSES=2
# SIMULATION_MESSAGE_INTERVAL_SECONDS=2

# Hybrid search tuning (semantic cut-off calibrated on the demo data).
# SEARCH_MIN_SIMILARITY=0.65
# SEARCH_SIMILARITY_MARGIN=0.06
# SEARCH_CANDIDATE_POOL=20

# Slack (Socket Mode). See README "Slack integration". Backend only; never in frontend/.env.
SLACK_ENABLED=false
SLACK_BOT_TOKEN=          # xoxb-... (scopes: channels:history, channels:read, users:read)
SLACK_APP_TOKEN=          # xapp-... (app-level token with connections:write)
# SLACK_SIGNING_SECRET=   # only for HTTP events; Socket Mode does not need it
# SLACK_CHANNEL_IDS=C0123456789   # optional: channels to monitor at worker start
